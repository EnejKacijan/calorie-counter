PORT=3000
HOST=0.0.0.0
USDA_API_KEY=DEMO_KEY
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=200
AI_MAX_CONCURRENT=4
# Enable only behind a trusted proxy that replaces incoming X-Forwarded-For.
TRUST_PROXY=false
ALLOW_IOS_ORIGIN=false
# Required when preparing a distributable native build (HTTPS backend origin).
# INTAKE_API_ORIGIN=https://your-backend.example
